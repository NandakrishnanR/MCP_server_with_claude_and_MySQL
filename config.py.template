import os
from dataclasses import dataclass
from typing import Optional

@dataclass
class DatabaseConfig:
    host: str = os.getenv('DB_HOST', 'localhost')
    port: int = int(os.getenv('DB_PORT', '3306'))
    user: str = os.getenv('DB_USER', 'root')
    password: str = os.getenv('DB_PASSWORD', '')
    name: str = os.getenv('DB_NAME', 'aaitech_inventory')

@dataclass
class SlackConfig:
    webhook_url: Optional[str] = os.getenv('SLACK_WEBHOOK_URL', 'YOUR_SLACK_WEBHOOK_URL_HERE')
    channel: str = os.getenv('SLACK_CHANNEL', '#your-channel')
    username: str = os.getenv('SLACK_USERNAME', 'Inventory Automation Bot')

@dataclass
class EmailConfig:
    smtp_server: str = os.getenv('SMTP_SERVER', 'smtp.gmail.com')
    smtp_port: int = int(os.getenv('SMTP_PORT', '587'))
    username: str = os.getenv('EMAIL_USERNAME', 'your_email@gmail.com')
    password: str = os.getenv('EMAIL_PASSWORD', 'your_app_password')
    from_email: str = os.getenv('FROM_EMAIL', 'your_email@gmail.com')
    # Manager/alerts recipient (used for inventory alerts and summaries)
    to_email: str = os.getenv('TO_EMAIL', 'manager@company.com')
    # Default fallback for intern welcome emails when a name has no directory entry
    default_welcome_email: str = os.getenv('DEFAULT_WELCOME_EMAIL', 'intern@company.com')

def get_db_config_dict():
    """Convert DatabaseConfig to dict for mysql.connector"""
    c = DatabaseConfig()
    return {
        "host": c.host,
        "port": c.port,
        "user": c.user,
        "password": c.password,
        "database": c.name,
        "unix_socket": "/tmp/mysql.sock"  # Use socket connection for local MySQL
    }